  id         String   @id @default(uuid()) @db.Uuid
  claim_id   String   @db.Uuid
  user_id    String   @db.Uuid
  event_type String   @db.VarChar(50) // 'CREATED', 'STATUS_CHANGED', 'APPROVED', 'REJECTED', 'SETTLED', 'NOTE_ADDED'
  old_status String?  @db.VarChar(50)
  new_status String?  @db.VarChar(50)
  notes      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz

  claim Claim @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([claim_id])
  @@map("claim_events")
}

// ── Barcode & Label Models (Module 12) ────────────────────────────────────

model ItemBarcode {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  item_id      String   @db.Uuid
  barcode      String   @db.VarChar(100)
  barcode_type String   @default("CODE128") @db.VarChar(50) // 'CODE128', 'EAN13', 'EAN8', 'UPC_A', 'QR', 'SUPPLIER', 'INTERNAL'
  is_primary   Boolean  @default(false)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([company_id, barcode], name: "uix_item_barcode_company_barcode")
  @@index([company_id, barcode, is_active])
  @@index([item_id])
  @@map("item_barcodes")
}

model LabelTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  name          String   @db.VarChar(100)
  template_type String   @default("PRODUCT") @db.VarChar(50) // 'PRODUCT', 'MRP', 'INWARD', 'SHELF'
  paper_type    String   @default("ROLL") @db.VarChar(50) // 'ROLL', 'SHEET'
  width_mm      Decimal  @default(50) @db.Decimal(8, 2)
  height_mm     Decimal  @default(25) @db.Decimal(8, 2)
  columns       Int      @default(1)
  is_default    Boolean  @default(false)
  is_active     Boolean  @default(true)
  config_json   String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  @@index([company_id, template_type])
  @@map("label_templates")
}

// ── Module 13: Pricing & Schemes Models ──────────────────────────────────────

model PriceList {
  id            String    @id @default(uuid()) @db.Uuid
  company_id    String    @db.Uuid
  branch_id     String?   @db.Uuid
  code          String    @db.VarChar(50)
  name          String    @db.VarChar(255)
  currency      String    @default("INR") @db.VarChar(10)
  status        String    @default("ACTIVE") @db.VarChar(50) // 'ACTIVE', 'INACTIVE'
  valid_from    DateTime? @db.Date
  valid_to      DateTime? @db.Date
  priority      Int       @default(0)
  customer_type String?   @db.VarChar(50) // 'WHOLESALE', 'RETAIL', etc. or null
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz

  company Company         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch?         @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  items   PriceListItem[]
  parties Party[]

  @@unique([company_id, code])
  @@index([company_id, status])
  @@index([valid_from, valid_to])
  @@map("price_lists")
}

model PriceListItem {
  id               String   @id @default(uuid()) @db.Uuid
  price_list_id    String   @db.Uuid
  item_id          String   @db.Uuid
  unit_id          String?  @db.Uuid
  rate             Decimal  @db.Decimal(15, 6)
  min_qty          Decimal  @default(0) @db.Decimal(15, 6)
  max_qty          Decimal? @db.Decimal(15, 6)
  discount_percent Decimal  @default(0) @db.Decimal(10, 2)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz

  price_list PriceList @relation(fields: [price_list_id], references: [id], onDelete: Cascade)
  item       Item      @relation(fields: [item_id], references: [id], onDelete: Restrict)
  unit       Unit?     @relation(fields: [unit_id], references: [id], onDelete: SetNull)

  @@unique([price_list_id, item_id, min_qty])
  @@index([price_list_id, item_id])
  @@map("price_list_items")
}

model CustomerItemPrice {
  id         String    @id @default(uuid()) @db.Uuid
  company_id String    @db.Uuid
  party_id   String    @db.Uuid
  item_id    String    @db.Uuid
  unit_id    String?   @db.Uuid
  rate       Decimal   @db.Decimal(15, 6)
  min_qty    Decimal   @default(0) @db.Decimal(15, 6)
  max_qty    Decimal?  @db.Decimal(15, 6)
  valid_from DateTime? @db.Date
  valid_to   DateTime? @db.Date
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  party   Party   @relation(fields: [party_id], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Restrict)
  unit    Unit?   @relation(fields: [unit_id], references: [id], onDelete: SetNull)

  @@unique([party_id, item_id, min_qty])
  @@index([company_id, party_id, item_id])
  @@map("customer_item_prices")
}

model PromotionScheme {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  branch_id        String?   @db.Uuid
  code             String    @db.VarChar(50)
  name             String    @db.VarChar(255)
  scheme_type      String    @db.VarChar(50) // 'BUY_X_GET_Y', 'FREE_QUANTITY', 'ITEM_DISCOUNT', 'BILL_DISCOUNT', 'PROMOTIONAL'
  status           String    @default("ACTIVE") @db.VarChar(50) // 'ACTIVE', 'INACTIVE'
  valid_from       DateTime? @db.Date
  valid_to         DateTime? @db.Date
  priority         Int       @default(0)
  stackable        Boolean   @default(false)
  customer_type    String?   @db.VarChar(50) // 'WHOLESALE', 'RETAIL' or null
  party_id         String?   @db.Uuid
  item_id          String?   @db.Uuid
  buy_quantity     Decimal?  @db.Decimal(15, 6)
  get_quantity     Decimal?  @db.Decimal(15, 6)
  free_item_id     String?   @db.Uuid
  discount_percent Decimal?  @db.Decimal(10, 2)
  discount_amount  Decimal?  @db.Decimal(15, 6)
  min_order_amount Decimal?  @db.Decimal(15, 6)
  max_benefit      Decimal?  @db.Decimal(15, 6)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz

  company   Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch    Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  party     Party?  @relation(fields: [party_id], references: [id], onDelete: SetNull)
  item      Item?   @relation("SchemeItem", fields: [item_id], references: [id], onDelete: SetNull)
  free_item Item?   @relation("SchemeFreeItem", fields: [free_item_id], references: [id], onDelete: SetNull)

  @@unique([company_id, code])
  @@index([company_id, status])
  @@index([valid_from, valid_to])
  @@map("promotion_schemes")
}

model PricingTrace {
  id                     String   @id @default(uuid()) @db.Uuid
  company_id             String   @db.Uuid
  document_type          String   @db.VarChar(50) // 'SALES_INVOICE', 'SALES_ORDER', 'SALES_QUOTATION', 'POS_SALE'
  document_id            String   @db.Uuid
  line_id                String?  @db.Uuid
  item_id                String   @db.Uuid
  party_id               String?  @db.Uuid
  pricing_engine_version String   @default("1.0.0") @db.VarChar(20)
  base_price             Decimal  @db.Decimal(15, 6)
  resolved_rate          Decimal  @db.Decimal(15, 6)
  price_list_id          String?  @db.Uuid
  price_list_item_id     String?  @db.Uuid
  customer_rate_id       String?  @db.Uuid
  quantity_slab_id       String?  @db.Uuid
  promotion_id           String?  @db.Uuid
  original_quantity      Decimal  @db.Decimal(15, 6)
  charged_quantity       Decimal  @db.Decimal(15, 6)
  free_quantity          Decimal  @default(0) @db.Decimal(15, 6)
  discount_amount        Decimal  @default(0) @db.Decimal(15, 6)
  discount_percent       Decimal  @default(0) @db.Decimal(10, 2)
  final_unit_price       Decimal  @db.Decimal(15, 6)
  final_line_amount      Decimal  @db.Decimal(15, 6)
  precedence_reason      String?  @db.VarChar(255)
  trace_details_json     String   @db.Text
  created_at             DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Restrict)
  party   Party?  @relation(fields: [party_id], references: [id], onDelete: SetNull)

  @@index([company_id, document_type, document_id])
  @@index([line_id])
  @@index([item_id])
  @@map("pricing_traces")
}

model BankAccount {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  branch_id         String?  @db.Uuid
  ledger_account_id String   @unique @db.Uuid
  bank_name         String   @db.VarChar(100)
  account_number    String   @db.VarChar(50)
  ifsc_code         String?  @db.VarChar(20)
  branch_name       String?  @db.VarChar(100)
  account_type      String   @default("CURRENT") @db.VarChar(20) // 'CURRENT', 'SAVINGS', 'OD', 'CC'
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz

  company        Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch         Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  ledger_account LedgerAccount @relation(fields: [ledger_account_id], references: [id], onDelete: Restrict)
  cheques        Cheque[]

  @@map("bank_accounts")
}

model Cheque {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  branch_id         String?  @db.Uuid
  financial_year_id String?  @db.Uuid
  cheque_type       String   @db.VarChar(20) // 'ISSUED', 'RECEIVED'
  cheque_number     String   @db.VarChar(50)
  cheque_date       DateTime @db.Date
  amount            Decimal  @db.Decimal(15, 6)

  party_id         String? @db.Uuid // If received from or issued to a Party
  bank_account_id  String? @db.Uuid // If issued by us (our BankAccount)
  drawee_bank_name String? @db.VarChar(100) // For received cheques, which bank the customer used

  status String @default("PENDING") @db.VarChar(20) // 'PENDING', 'CLEARED', 'BOUNCED', 'CANCELLED', 'DEPOSITED'

  voucher_id String? @unique @db.Uuid // Link to the accounting voucher once it's posted/cleared

  cleared_date  DateTime? @db.Date
  bounce_reason String?   @db.VarChar(255)
  notes         String?   @db.Text

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  party        Party?       @relation(fields: [party_id], references: [id], onDelete: Restrict)
  bank_account BankAccount? @relation(fields: [bank_account_id], references: [id], onDelete: Restrict)
  voucher      Voucher?     @relation(fields: [voucher_id], references: [id], onDelete: SetNull)

  @@index([company_id, status])
  @@index([company_id, cheque_type])
  @@index([cheque_date])
  @@map("cheques")
}

model BankReconciliation {
  id                  String   @id @default(uuid()) @db.Uuid
  company_id          String   @db.Uuid
  bank_account_id     String   @db.Uuid
  reconciliation_date DateTime @db.Date
  statement_balance   Decimal  @db.Decimal(15, 6)
  book_balance        Decimal  @db.Decimal(15, 6)
  difference          Decimal  @db.Decimal(15, 6)
  status              String   @default("DRAFT") @db.VarChar(20) // 'DRAFT', 'COMPLETED'
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  @@map("bank_reconciliations")
}

// ── Retail Phase 2 Models ───────────────────────────────────────────────────

model NeedList {
  id                    String    @id @default(uuid()) @db.Uuid
  organization_id       String    @db.Uuid
  company_id            String    @db.Uuid
  branch_id             String?   @db.Uuid
  name                  String    @db.VarChar(255)
  quantity              Decimal   @default(1) @db.Decimal(15, 6)
  customer_id           String?   @db.Uuid
  customer_phone        String?   @db.VarChar(50)
  preferred_supplier_id String?   @db.Uuid
  needed_by             DateTime? @db.Date
  priority              String    @default("NORMAL") @db.VarChar(50)
  source                String    @default("SHOP") @db.VarChar(50)
  status                String    @default("NEED") @db.VarChar(50) // 'NEED', 'ORDERED', 'RECEIVED', 'CANCELLED'
  note                  String?   @db.Text
  created_by            String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz

  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company            Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch             Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  customer           Party?       @relation("NeedListCustomer", fields: [customer_id], references: [id], onDelete: SetNull)
  preferred_supplier Party?       @relation("NeedListSupplier", fields: [preferred_supplier_id], references: [id], onDelete: SetNull)
  user               User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([company_id, status])
  @@map("need_lists")
}

model Attachment {
  id              String  @id @default(uuid()) @db.Uuid
  organization_id String  @db.Uuid
  company_id      String  @db.Uuid
  branch_id       String? @db.Uuid

  entity_type String @db.VarChar(100)
  entity_id   String @db.Uuid
  category    String @db.VarChar(100)

  original_file_name String @db.VarChar(255)
  stored_file_name   String @db.VarChar(255)
  mime_type          String @db.VarChar(100)
  file_size          Int

  storage_provider String @db.VarChar(50)
  storage_key      String @db.VarChar(500)

  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)
  expense      Expense?

  @@index([company_id, entity_type, entity_id])
  @@map("attachments")
}

// -- Retail Expense Models ----------------------------------------------------------

model ExpenseCategory {
  id              String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  company_id      String @db.Uuid

  name      String  @db.VarChar(255)
  icon      String? @db.VarChar(50)
  is_active Boolean @default(true)
  ledger_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company        Company        @relation(fields: [company_id], references: [id], onDelete: Restrict)
  ledger_account LedgerAccount? @relation(fields: [ledger_id], references: [id], onDelete: SetNull)

  expenses Expense[]

  @@unique([company_id, name])
  @@map("expense_categories")
}

model Expense {
  id              String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  company_id      String @db.Uuid
  branch_id       String @db.Uuid

  type        String  @db.VarChar(50) // 'BUSINESS_EXPENSE', 'OWNER_WITHDRAWAL'
  category_id String? @db.Uuid

  amount         Decimal  @db.Decimal(15, 6)
  payment_method String   @db.VarChar(50) // 'CASH', 'UPI', 'BANK', 'CARD'
  date           DateTime @db.Date

  paid_to     String? @db.VarChar(255)
  bill_number String? @db.VarChar(100)
  note        String? @db.Text

  status     String  @default("POSTED") @db.VarChar(50) // 'POSTED', 'CANCELLED'
  voucher_id String? @unique @db.Uuid
  attachment_id String? @unique @db.Uuid

  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  category     ExpenseCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  attachment   Attachment?      @relation(fields: [attachment_id], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([company_id, branch_id, date])
  @@map("expenses")
}
