generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity Models ─────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organization_id    String?   @db.Uuid
  username           String    @unique @db.VarChar(255)
  display_name       String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  password_hash      String    @db.VarChar(255)
  is_active          Boolean   @default(true)
  is_locked          Boolean   @default(false)
  failed_login_count Int       @default(0)
  language           String    @default("en") @db.VarChar(10)
  last_login_at      DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz

  roles            UserRole[]
  sessions         Session[]
  password_history PasswordHistory[]

  goods_receipts           GoodsReceipt[]
  vouchers                 Voucher[]
  reversed_vouchers        Voucher[]         @relation("VoucherReversedBy")
  purchase_invoices        PurchaseInvoice[]
  purchase_returns         PurchaseReturn[]
  sales_quotations         SalesQuotation[]
  sales_orders             SalesOrder[]
  delivery_challans        DeliveryChallan[]
  sales_invoices           SalesInvoice[]
  sales_returns            SalesReturn[]
  audit_logs               AuditLog[]
  posted_stock_adjustments StockAdjustment[] @relation("StockAdjustmentPoster")
  posted_stock_transfers   StockTransfer[]   @relation("StockTransferPoster")
  posted_opening_stocks    OpeningStock[]    @relation("OpeningStockPoster")
  counted_stock_counts     StockCount[]      @relation("StockCountCounter")
  posted_stock_counts      StockCount[]      @relation("StockCountPoster")
  PosShift                 PosShift[]
  created_claims           Claim[]           @relation("ClaimCreator")
  approved_claims          Claim[]           @relation("ClaimApprover")
  settled_claims           Claim[]           @relation("ClaimSettler")
  claim_events             ClaimEvent[]
  need_lists               NeedList[]
  Attachment               Attachment[]
  Expense                  Expense[]

  @@map("users")
}

model Role {
  id              String  @id @default(uuid()) @db.Uuid
  organization_id String? @db.Uuid
  name            String  @db.VarChar(255)
  description     String? @db.Text
  system_role     Boolean @default(false)

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([organization_id, name], name: "uix_roles_org_name")
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(255)
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String? @db.Text

  role_permissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id    String  @db.Uuid
  role_id    String  @db.Uuid
  company_id String? @db.Uuid
  branch_id  String? @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid
  scope         String @default("ALL_COMPANIES") @db.VarChar(50)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  device_id  String?   @db.VarChar(255)
  issued_at  DateTime  @default(now()) @db.Timestamptz
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(512)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordHistory {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_history")
}

// ── Platform Identity Models ─────────────────────────────────────────────────

model PlatformUser {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(255)
  display_name       String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  password_hash      String    @db.VarChar(255)
  is_active          Boolean   @default(true)
  is_locked          Boolean   @default(false)
  failed_login_count Int       @default(0)
  last_login_at      DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz

  roles      PlatformUserRole[]
  sessions   PlatformSession[]
  audit_logs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(255)
  description String? @db.Text
  system_role Boolean @default(false)

  role_permissions PlatformRolePermission[]
  user_roles       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(255)
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String? @db.Text

  role_permissions PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformUserRole {
  user_id String @db.Uuid
  role_id String @db.Uuid

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("platform_user_roles")
}

model PlatformRolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       PlatformRole       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("platform_role_permissions")
}

model PlatformSession {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  device_id  String?   @db.VarChar(255)
  issued_at  DateTime  @default(now()) @db.Timestamptz
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(512)

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("platform_sessions")
}

model PlatformAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  action        String   @db.VarChar(100)
  resource_type String?  @db.VarChar(100)
  resource_id   String?  @db.Uuid
  details       String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("platform_audit_logs")
}

// ── Platform Billing & Entitlement Models ────────────────────────────────────

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  organizations Organization[]
  plan_features PlanFeature[]

  @@map("plans")
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  plan_features       PlanFeature[]
  tenant_entitlements TenantEntitlement[]

  @@map("features")
}

model PlanFeature {
  plan_id    String @db.Uuid
  feature_id String @db.Uuid

  plan    Plan    @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@id([plan_id, feature_id])
  @@map("plan_features")
}

model TenantEntitlement {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  feature_id      String   @db.Uuid
  is_enabled      Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, feature_id], name: "uix_tenant_entitlements")
  @@map("tenant_entitlements")
}

model OwnerInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  email           String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  token_hash      String    @unique @db.VarChar(255)
  expires_at      DateTime  @db.Timestamptz
  accepted_at     DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("owner_invitations")
}

// ── Organization Models ─────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar(255)
  legal_name String?      @db.VarChar(255)
  code       String       @unique @db.VarChar(50)
  status     TenantStatus @default(TRIAL)
  is_active  Boolean      @default(true)
  plan_id    String?      @db.Uuid

  // Tenant Branding/Settings
  logo_url       String? @db.VarChar(512)
  primary_color  String? @db.VarChar(7)
  invoice_footer String? @db.Text

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  plan                Plan?               @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  companies           Company[]
  owner_invitations   OwnerInvitation[]
  tenant_entitlements TenantEntitlement[]
  need_lists          NeedList[]
  Attachment          Attachment[]
  ExpenseCategory     ExpenseCategory[]
  Expense             Expense[]

  @@index([code], name: "ix_organizations_code")
  @@index([is_active], name: "ix_organizations_is_active")
  @@index([status], name: "ix_organizations_status")
  @@map("organizations")
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  code            String   @db.VarChar(50)
  legal_name      String   @db.VarChar(255)
  trade_name      String?  @db.VarChar(255)
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  country         String   @default("India") @db.VarChar(100)
  postal_code     String?  @db.VarChar(20)
  phone           String?  @db.VarChar(50)
  email           String?  @db.VarChar(255)
  gstin           String?  @db.VarChar(15)
  pan             String?  @db.VarChar(10)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(50)
  fy_start_month  Int      @default(4)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  branches        Branch[]
  financial_years FinancialYear[]

  parties                  Party[]
  units                    Unit[]
  tax_classes              TaxClass[]
  items                    Item[]
  purchase_orders          PurchaseOrder[]
  goods_receipts           GoodsReceipt[]
  purchase_invoices        PurchaseInvoice[]
  purchase_returns         PurchaseReturn[]
  sales_quotations         SalesQuotation[]
  sales_orders             SalesOrder[]
  delivery_challans        DeliveryChallan[]
  sales_invoices           SalesInvoice[]
  sales_returns            SalesReturn[]
  stock_movements          StockMovement[]
  stock_balance_projection StockBalanceProjection[]
  ledger_accounts          LedgerAccount[]
  vouchers                 Voucher[]
  bill_allocations         BillAllocation[]
  audit_logs               AuditLog[]
  configuration            CompanyConfiguration?
  StockAdjustment          StockAdjustment[]
  StockTransfer            StockTransfer[]
  OpeningStock             OpeningStock[]
  StockCount               StockCount[]
  PosShift                 PosShift[]
  return_reasons           ReturnReason[]
  claims                   Claim[]
  item_barcodes            ItemBarcode[]
  label_templates          LabelTemplate[]
  price_lists              PriceList[]
  customer_item_prices     CustomerItemPrice[]
  promotion_schemes        PromotionScheme[]
  pricing_traces           PricingTrace[]
  CreditOverride           CreditOverride[]
  BankAccount              BankAccount[]
  Cheque                   Cheque[]
  BankReconciliation       BankReconciliation[]
  need_lists               NeedList[]
  Attachment               Attachment[]
  ExpenseCategory          ExpenseCategory[]
  Expense                  Expense[]

  @@unique([organization_id, code], name: "uix_companies_org_code")
  @@index([organization_id], name: "ix_companies_organization_id")
  @@index([is_active], name: "ix_companies_is_active")
  @@map("companies")
}

model CompanyConfiguration {
  company_id             String   @id @db.Uuid
  currency               String   @default("INR") @db.VarChar(10)
  default_branch_id      String?  @db.Uuid
  default_cash_ledger_id String?  @db.Uuid
  default_bank_ledger_id String?  @db.Uuid
  tax_configuration      Json?
  invoice_configuration  Json?
  created_at             DateTime @default(now()) @db.Timestamptz
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz

  company     Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch      Branch?        @relation(fields: [default_branch_id], references: [id], onDelete: SetNull)
  cash_ledger LedgerAccount? @relation("ConfigCashLedger", fields: [default_cash_ledger_id], references: [id], onDelete: SetNull)
  bank_ledger LedgerAccount? @relation("ConfigBankLedger", fields: [default_bank_ledger_id], references: [id], onDelete: SetNull)

  @@map("company_configurations")
}

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  country     String   @default("India") @db.VarChar(100)
  postal_code String?  @db.VarChar(20)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(255)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  company Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  godowns Godown[]

  purchase_orders          PurchaseOrder[]
  goods_receipts           GoodsReceipt[]
  purchase_invoices        PurchaseInvoice[]
  purchase_returns         PurchaseReturn[]
  sales_quotations         SalesQuotation[]
  sales_orders             SalesOrder[]
  delivery_challans        DeliveryChallan[]
  sales_invoices           SalesInvoice[]
  sales_returns            SalesReturn[]
  stock_movements          StockMovement[]
  stock_balance_projection StockBalanceProjection[]
  ledger_accounts          LedgerAccount[]
  vouchers                 Voucher[]
  audit_logs               AuditLog[]
  company_configurations   CompanyConfiguration[]
  StockAdjustment          StockAdjustment[]
  StockTransfer            StockTransfer[]
  OpeningStock             OpeningStock[]
  StockCount               StockCount[]
  PosShift                 PosShift[]
  claims                   Claim[]
  price_lists              PriceList[]
  promotion_schemes        PromotionScheme[]
  BankAccount              BankAccount[]
  Cheque                   Cheque[]
  need_lists               NeedList[]
  Attachment               Attachment[]
  Expense                  Expense[]

  @@unique([company_id, code], name: "uix_branches_company_code")
  @@index([company_id], name: "ix_branches_company_id")
  @@index([is_active], name: "ix_branches_is_active")
  @@map("branches")
}

model Godown {
  id          String   @id @default(uuid()) @db.Uuid
  branch_id   String   @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  goods_receipt_lines      GoodsReceiptLine[]
  purchase_invoice_lines   PurchaseInvoiceLine[]
  purchase_return_lines    PurchaseReturnLine[]
  delivery_challan_lines   DeliveryChallanLine[]
  sales_invoice_lines      SalesInvoiceLine[]
  sales_return_lines       SalesReturnLine[]
  stock_movements          StockMovement[]
  stock_balance_projection StockBalanceProjection[]

  stock_adjustments      StockAdjustmentLine[]
  stock_transfers_source StockTransfer[]       @relation("TransferSource")
  stock_transfers_dest   StockTransfer[]       @relation("TransferDestination")
  opening_stock_lines    OpeningStockLine[]
  stock_counts           StockCount[]

  @@unique([branch_id, code], name: "uix_godowns_branch_code")
  @@index([branch_id], name: "ix_godowns_branch_id")
  @@index([is_active], name: "ix_godowns_is_active")
  @@map("godowns")
}

model FinancialYear {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  label      String   @db.VarChar(100)
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  is_active  Boolean  @default(false)
  is_closed  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  purchase_invoices PurchaseInvoice[]
  purchase_returns  PurchaseReturn[]
  sales_invoices    SalesInvoice[]
  sales_returns     SalesReturn[]
  vouchers          Voucher[]
  StockAdjustment   StockAdjustment[]
  StockTransfer     StockTransfer[]
  OpeningStock      OpeningStock[]
  StockCount        StockCount[]

  @@unique([company_id, label], name: "uix_fy_company_label")
  @@index([company_id], name: "ix_financial_years_company_id")
  @@index([is_active], name: "ix_financial_years_is_active")
  @@map("financial_years")
}

// ── Master Models ───────────────────────────────────────────────────────────

model Party {
  id                      String    @id @default(uuid()) @db.Uuid
  company_id              String    @db.Uuid
  code                    String    @db.VarChar(50)
  party_type              String    @db.VarChar(50) // 'CUSTOMER' or 'SUPPLIER'
  name                    String    @db.VarChar(255)
  legal_name              String?   @db.VarChar(255)
  gstin                   String?   @db.VarChar(15)
  pan                     String?   @db.VarChar(10)
  state_code              String?   @db.VarChar(10)
  credit_days             Int?
  credit_limit            Decimal?  @db.Decimal(15, 6)
  temporary_credit_limit  Decimal?  @db.Decimal(15, 6)
  temporary_credit_expiry DateTime? @db.Date
  is_blocked              Boolean   @default(false)
  block_reason            String?   @db.Text
  blocked_at              DateTime? @db.Timestamptz
  is_active               Boolean   @default(true)
  is_walkin               Boolean   @default(false)
  price_list_id           String?   @db.Uuid

  company    Company    @relation(fields: [company_id], references: [id], onDelete: Restrict)
  price_list PriceList? @relation(fields: [price_list_id], references: [id], onDelete: SetNull)

  purchase_orders        PurchaseOrder[]
  goods_receipts         GoodsReceipt[]
  purchase_invoices      PurchaseInvoice[]
  purchase_returns       PurchaseReturn[]
  sales_quotations       SalesQuotation[]
  sales_orders           SalesOrder[]
  delivery_challans      DeliveryChallan[]
  sales_invoices         SalesInvoice[]
  sales_returns          SalesReturn[]
  ledger_accounts        LedgerAccount[]
  voucher_lines          VoucherLine[]
  bill_allocations       BillAllocation[]
  claims                 Claim[]
  customer_item_prices   CustomerItemPrice[]
  promotion_schemes      PromotionScheme[]
  pricing_traces         PricingTrace[]
  credit_overrides       CreditOverride[]
  Cheque                 Cheque[]
  need_lists_as_customer NeedList[]          @relation("NeedListCustomer")
  need_lists_as_supplier NeedList[]          @relation("NeedListSupplier")

  @@index([code])
  @@index([name])
  @@index([gstin])
  @@map("parties")
}

model CreditOverride {
  id                   String    @id @default(uuid()) @db.Uuid
  company_id           String    @db.Uuid
  party_id             String    @db.Uuid
  override_type        String    @db.VarChar(50) // 'CREDIT_LIMIT_INCREASE', 'OVERDUE_BYPASS', 'BLOCK_OVERRIDE'
  requested_by         String    @db.Uuid
  approved_by          String?   @db.Uuid
  status               String    @default("PENDING") @db.VarChar(50) // 'PENDING', 'APPROVED', 'REJECTED', 'EXPIRED'
  override_amount      Decimal?  @db.Decimal(15, 6)
  valid_until          DateTime? @db.Date
  reason               String?   @db.Text
  approval_notes       String?   @db.Text
  source_document_type String?   @db.VarChar(100) // e.g. 'SALES_ORDER', 'SALES_INVOICE'
  source_document_id   String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  party   Party   @relation(fields: [party_id], references: [id], onDelete: Restrict)

  @@index([company_id, party_id])
  @@index([status])
  @@map("credit_overrides")
}

model Unit {
  id             String @id @default(uuid()) @db.Uuid
  company_id     String @db.Uuid
  code           String @db.VarChar(50)
  name           String @db.VarChar(255)
  decimal_places Int    @default(0)

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  items                  Item[]
  purchase_order_lines   PurchaseOrderLine[]
  goods_receipt_lines    GoodsReceiptLine[]
  purchase_invoice_lines PurchaseInvoiceLine[]
  purchase_return_lines  PurchaseReturnLine[]
  sales_quotation_lines  SalesQuotationLine[]
  sales_order_lines      SalesOrderLine[]
  delivery_challan_lines DeliveryChallanLine[]
  sales_invoice_lines    SalesInvoiceLine[]
  sales_return_lines     SalesReturnLine[]
  stock_movements        StockMovement[]
  StockAdjustmentLine    StockAdjustmentLine[]
  StockTransferLine      StockTransferLine[]
  OpeningStockLine       OpeningStockLine[]
  StockCountLine         StockCountLine[]
  claim_lines            ClaimLine[]
  price_list_items       PriceListItem[]
  customer_item_prices   CustomerItemPrice[]

  @@map("units")
}

model TaxClass {
